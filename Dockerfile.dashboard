FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application files
COPY dashboard_server.py .
COPY database_queries.py .
COPY start_dashboard.py .
COPY templates/ templates/
COPY static/ static/

# Create data directory for database and ensure proper permissions
RUN mkdir -p /app/data && chmod 755 /app/data

# Set environment variables with defaults
ENV DATABASE_PATH=/app/data/bms_telemetry.db
ENV FLASK_HOST=0.0.0.0
ENV FLASK_PORT=5000
ENV FLASK_DEBUG=false

# Create non-root user for security
RUN groupadd -r bms && useradd -r -g bms bms
RUN chown -R bms:bms /app
USER bms

# Expose the Flask port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:5000/api/health', timeout=5)" || exit 1

# Run the dashboard server
CMD ["python", "dashboard_server.py"]