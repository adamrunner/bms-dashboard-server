# Dedicated backend logger account. The deny rule takes precedence over the
# device pattern below, keeping this account read-only.
user bms-logger
topic deny write bms/telemetry/bms-logger
topic deny write bms/status/bms-logger
topic deny write bms/availability/bms-logger
topic deny write charger/telemetry/bms-logger
topic read bms/telemetry/+
topic read bms/status/+
topic read bms/availability/+
topic read charger/telemetry/+
topic read $SYS/broker/uptime

# Legacy account retained temporarily for esp32-bms-monitor migration.
# deploy/anton/configure-mqtt-credentials.sh retire-admin removes its password
# entry after all older clients have been reconfigured.
user admin
topic readwrite #
topic read $SYS/broker/uptime

# Device usernames must equal the final topic segment (their device_id).
# Example: username gw-a1b2c3 may publish only its telemetry and retained
# boot/OTA status records, plus Renogy DC-DC charger rows from a gateway
# polling the charger over RS485.
pattern write bms/telemetry/%u
pattern write bms/status/%u
pattern write bms/availability/%u
pattern write charger/telemetry/%u
