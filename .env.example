# BMS Docker Configuration Environment Variables

# MQTT Broker Configuration
# Use 'mosquitto' for internal broker or external hostname/IP
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=admin
MQTT_PASSWORD=password1234
MQTT_TOPIC=bms/telemetry

# Mosquitto Service Configuration
MQTT_EXTERNAL_PORT=1883
MQTT_WEBSOCKET_PORT=9001

# Dashboard Configuration
DASHBOARD_PORT=5000
FLASK_DEBUG=false

# Optional: Override default settings
# DATABASE_PATH is handled internally by containers via volume mounts

# External MQTT Broker Example:
# MQTT_BROKER=hostname.local
# MQTT_PORT=1883
